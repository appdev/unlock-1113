+	second, err := effectiveSyncS3()
+	if err != nil || second.AccessKey == first.AccessKey || second.Bucket != first.Bucket {
+		t.Fatal("device credentials are not independent for the same storage space")
+	}
+	b := newRepo("managed-b", second, append([]byte(nil), Conf.Repo.Load().Key...))
+	if err = b.ConfigureAssetDownloads(true, filepath.Join(t.TempDir(), "asset-state"), "managed-integration"); err != nil {
+		t.Fatal(err)
