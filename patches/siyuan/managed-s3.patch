+			t.Fatal(err)
+		}
+		if _, _, _, err = a.UploadTagIndex(tag, index.ID, nil); err != nil {
+			t.Fatalf("real cloud backup upload failed: %v", err)
+		}
+	}
+	if _, _, err = a.Sync(nil); err != nil {
+		t.Fatal(err)
+	}
+	logs, err := a.GetCloudRepoTagLogs(nil)
+	if err != nil || len(logs) < 35 {
+		t.Fatalf("real V1 tag pagination failed: count=%d error=%v", len(logs), err)
+	}
+	if _, _, _, err = downloadCloudSnapshotIndex(b, "managed-tag-00", index.ID, nil); err != nil {
+		t.Fatalf("real cloud backup download failed: %v", err)
+	}
+	if _, _, err = b.Checkout(index.ID, nil); err != nil {
+		t.Fatal(err)
+	}
+	if content, err := os.ReadFile(filepath.Join(b.DataPath, "seed.txt")); err != nil || !bytes.Equal(content, []byte("managed source version one")) {
+		t.Fatal("restored cloud backup content mismatch")
+	}
+	if _, err = LogoutManagedStorage(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	write(a, "other-device.txt", []byte("first device remains authorized"))
+	if _, err = a.Index("independent session", true, nil); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err = a.Sync(nil); err != nil {
+		t.Fatalf("logging out a peer revoked the first device: %v", err)
+	}
+	t.Log("real portal, RustFS, encrypted transfer, wrong-key rejection, on-demand attachment digest, peer merge, V1 pagination and device isolation passed")
+}
