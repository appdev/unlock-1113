+	}
+	t.Setenv("SIYUAN_MANAGED_STORAGE_KEY_FILE", key)
+	if _, err := newManagedStorageStore("https://storage.example", true); err == nil {
+		t.Fatal("accepted wrapping key in synchronized workspace")
+	}
+	oldHome := util.HomeDir
+	util.HomeDir = util.WorkspaceDir
+	t.Cleanup(func() { util.HomeDir = oldHome })
+	if _, err := newManagedStorageStore("https://storage.example", true); err == nil {
+		t.Fatal("accepted credential store in workspace")
+	}
+}
+
+func TestManagedStorageLANScopeSurvivesUnavailableCredentials(t *testing.T) {
+	f := managedStorageTestSetup(t)
+	if _, err := LoginManagedStorage(context.Background(), "fixture-user", "synthetic-password", false); err != nil {
+		t.Fatal(err)
+	}
+	ready := lanSyncScope()
+	f.active = false
+	GetManagedStorageStatus(context.Background(), true)
+	if lanSyncScope() != ready {
+		t.Fatal("inactive service discarded the bound LAN repository identity")
+	}
+	c, _ := currentManagedStorageClient()
+	c.mu.Lock()
+	c.session.Storage.Bucket = "different-account-space"
+	c.mu.Unlock()
+	if lanSyncScope() == ready {
+		t.Fatal("unavailable storage sources share a LAN repository identity")
+	}
+}
+
+func TestManagedStorageLANDoesNotAdvertiseAnUnboundSource(t *testing.T) {
+	managedStorageTestSetup(t)
+	Conf.Sync.Load().ManagedStorage, Conf.Sync.Load().Enabled, Conf.Sync.Load().LAN.Enabled = true, true, true
+	refreshLANSyncManager()
+	if GetLANSyncDiscoveryInfo() != nil {
+		t.Fatal("unbound managed source started LAN discovery")
+	}
+}
