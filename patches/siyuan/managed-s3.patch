+func TestQingYuManagedKeyFirstLoginAndSecondDevice(t *testing.T) {
+	f := managedStorageTestSetup(t)
+	Conf.Repo.Load().Key = nil
+	status, err := LoginManagedStorageAndStart(context.Background(), "fixture-user", "synthetic-password", false)
+	if err != nil || !status.SyncEnabled || len(Conf.Repo.Load().Key) != 32 {
+		t.Fatal("first login did not recover and start", err)
+	}
+	first := append([]byte(nil), Conf.Repo.Load().Key...)
+	LogoutManagedStorage(context.Background())
+	Conf.Repo.Load().Key = nil
+	status, err = LoginManagedStorageAndStart(context.Background(), "fixture-user", "synthetic-password", false)
+	if err != nil || !status.SyncEnabled || !bytes.Equal(first, Conf.Repo.Load().Key) {
+		t.Fatal("second device did not recover same key", err)
+	}
+	f.mu.Lock()
+	same := bytes.Equal(f.repoKey, first)
+	f.mu.Unlock()
+	if !same {
+		t.Fatal("account key changed")
+	}
+	Conf.Repo.Load().Key = bytes.Repeat([]byte{1}, 32)
+	if _, err = effectiveManagedStorageS3(); err == nil || err.Error() != "repo_key_conflict" {
+		t.Fatal("changed local key bypassed binding")
+	}
+}
+
+func TestQingYuManagedKeyFailurePreservesLocalSource(t *testing.T) {
+	for _, scenario := range []string{"conflict", "legacy", "wrong-owner", "orphan-repo", "offline"} {
+		t.Run(scenario, func(t *testing.T) {
+			f := managedStorageTestSetup(t)
+			original := bytes.Repeat([]byte{42}, 32)
+			Conf.Repo.Load().Key = original
+			f.mu.Lock()
+			switch scenario {
+			case "conflict":
+				f.repoKey = make([]byte, 32)
+			case "legacy":
+				f.repoKeyError = "repo_key_required"
+			case "wrong-owner":
+				f.repoKeyBad = true
+			case "offline":
+				f.offline = true
+			case "orphan-repo":
+				Conf.Repo.Load().Key = nil
+				if err := os.MkdirAll(Conf.Repo.Load().GetSaveDir(), 0700); err != nil {
+					t.Fatal(err)
+				}
+				if err := os.WriteFile(filepath.Join(Conf.Repo.Load().GetSaveDir(), "preserved"), []byte("old encrypted data"), 0600); err != nil {
+					t.Fatal(err)
+				}
+			}
+			f.mu.Unlock()
+			old := Conf.Sync.Load()
+			if _, err := LoginManagedStorageAndStart(context.Background(), "fixture-user", "synthetic-password", false); err == nil {
+				t.Fatal("unsafe login succeeded")
+			}
+			if Conf.Sync.Load() != old || Conf.Sync.Load().ManagedStorage || Conf.Sync.Load().Enabled {
+				t.Fatal("failed recovery changed source")
+			}
+			if scenario != "orphan-repo" && !bytes.Equal(Conf.Repo.Load().Key, original) {
+				t.Fatal("failed recovery replaced key")
+			}
+			if scenario == "orphan-repo" {
+				if b, err := os.ReadFile(filepath.Join(Conf.Repo.Load().GetSaveDir(), "preserved")); err != nil || string(b) != "old encrypted data" {
+					t.Fatal("orphan repo discarded")
+				}
+			}
+		})
+	}
+}
+
+func TestQingYuManagedKeyRespectsManualSourceAfterLogin(t *testing.T) {
+	managedStorageTestSetup(t)
+	LoginManagedStorage(context.Background(), "fixture-user", "synthetic-password", false)
+	UpdateSyncConf(func(s *conf.Sync) { s.ManagedStorage = false })
+	if _, err := StartManagedStorageSync(context.Background(), "fixture-account"); err == nil {
+		t.Fatal("late recovery changed manual source")
+	}
+}
diff --git a/kernel/model/managed_storage_store.go b/kernel/model/managed_storage_store.go
new file mode 100644
--- /dev/null
+++ b/kernel/model/managed_storage_store.go
@@ -0,0 +1,165 @@
+// SiYuan - https://github.com/siyuan-note/siyuan
+// Copyright (c) 2020-present, b3log.org
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+package model
+
+import (
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+
+	"github.com/siyuan-note/siyuan/kernel/util"
+	"github.com/zalando/go-keyring"
+)
+
+type managedStorageStore struct {
+	path, scope string
+	key         []byte
+}
+
+func newManagedStorageStore(origin string, create bool) (*managedStorageStore, error) {
+	if util.WorkspaceDir == "" || util.HomeDir == "" {
+		return nil, errors.New("secure_storage_unavailable")
+	}
+	workspace, err := filepath.Abs(util.WorkspaceDir)
+	if err != nil || workspace == "" || util.HomeDir == "" {
+		return nil, errors.New("secure_storage_unavailable")
+	}
+	scope := origin + "\x00" + filepath.Clean(workspace)
+	id := sha256.Sum256([]byte(scope))
+	directory := filepath.Join(util.HomeDir, ".config", "siyuan", "managed-storage")
+	if info, err := os.Lstat(directory); err == nil && (!info.IsDir() || info.Mode()&os.ModeSymlink != 0 || runtime.GOOS != "windows" && info.Mode().Perm()&0077 != 0) {
+		return nil, errors.New("secure_storage_unavailable")
+	}
+	s := &managedStorageStore{path: filepath.Join(directory, hex.EncodeToString(id[:])+".bin"), scope: scope}
+	if managedStoragePathWithin(workspace, s.path) {
+		return nil, errors.New("secure_storage_unavailable")
+	}
+	if keyFile := os.Getenv("SIYUAN_MANAGED_STORAGE_KEY_FILE"); keyFile != "" {
+		if managedStoragePathWithin(workspace, keyFile) {
+			return nil, errors.New("secure_storage_unavailable")
+		}
+		info, err := os.Lstat(keyFile)
+		if err != nil || !info.Mode().IsRegular() || info.Mode().Perm()&0077 != 0 || runtime.GOOS == "windows" {
+			return nil, errors.New("secure_storage_unavailable")
+		}
+		raw, err := os.ReadFile(keyFile)
+		if err != nil {
+			return nil, errors.New("secure_storage_unavailable")
+		}
+		s.key, err = hex.DecodeString(strings.TrimSpace(string(raw)))
+		if err != nil || len(s.key) != 32 {
+			return nil, errors.New("secure_storage_unavailable")
+		}
+	} else {
+		account := hex.EncodeToString(id[:])
+		encoded, err := keyring.Get("SiYuan Managed Storage v1", account)
+		if errors.Is(err, keyring.ErrNotFound) && create {
+			s.key = make([]byte, 32)
+			if _, err = rand.Read(s.key); err == nil {
+				encoded = hex.EncodeToString(s.key)
+				err = keyring.Set("SiYuan Managed Storage v1", account, encoded)
+			}
+		}
+		if err != nil {
+			return nil, errors.New("secure_storage_unavailable")
+		}
+		s.key, err = hex.DecodeString(encoded)
+		if err != nil || len(s.key) != 32 {
+			return nil, errors.New("secure_storage_unavailable")
+		}
+	}
+	return s, nil
+}
+
+func managedStoragePathWithin(directory, name string) bool {
+	absolute, err := filepath.Abs(name)
+	if err != nil {
+		return true
+	}
+	relative, err := filepath.Rel(directory, absolute)
+	return err == nil && relative != ".." && !strings.HasPrefix(relative, ".."+string(filepath.Separator))
+}
+
+func (s *managedStorageStore) aead() (cipher.AEAD, error) {
+	block, err := aes.NewCipher(s.key)
+	if err != nil {
+		return nil, err
+	}
+	return cipher.NewGCM(block)
+}
+
+func (s *managedStorageStore) load(value *managedStorageSession) error {
+	info, err := os.Lstat(s.path)
+	if err != nil {
+		return err
+	}
+	if !info.Mode().IsRegular() || runtime.GOOS != "windows" && info.Mode().Perm()&0077 != 0 || info.Size() > 65536 {
+		return errors.New("secure_storage_unavailable")
+	}
+	data, err := os.ReadFile(s.path)
+	if err != nil {
+		return err
+	}
+	aead, err := s.aead()
+	if err != nil || len(data) < 1+aead.NonceSize()+aead.Overhead() || data[0] != 1 {
+		return errors.New("secure_storage_unavailable")
+	}
+	plain, err := aead.Open(nil, data[1:1+aead.NonceSize()], data[1+aead.NonceSize():], []byte(s.scope))
+	if err != nil || json.Unmarshal(plain, value) != nil {
+		return errors.New("secure_storage_unavailable")
+	}
+	return nil
+}
+
+func (s *managedStorageStore) save(value *managedStorageSession) error {
+	data, err := json.Marshal(value)
+	if err != nil {
+		return err
+	}
+	aead, err := s.aead()
+	if err != nil {
+		return err
+	}
+	nonce := make([]byte, aead.NonceSize())
+	if _, err = rand.Read(nonce); err != nil {
+		return err
+	}
+	sealed := aead.Seal(append([]byte{1}, nonce...), nonce, data, []byte(s.scope))
+	if err = os.MkdirAll(filepath.Dir(s.path), 0700); err != nil {
+		return err
+	}
+	file, err := os.CreateTemp(filepath.Dir(s.path), ".session-*")
+	if err != nil {
+		return err
+	}
+	defer os.Remove(file.Name())
+	if _, err = file.Write(sealed); err == nil {
+		err = file.Sync()
+	}
+	closeErr := file.Close()
+	if err != nil {
+		return err
+	}
+	if closeErr != nil {
+		return closeErr
+	}
+	return os.Rename(file.Name(), s.path)
+}
+
+func (s *managedStorageStore) remove() error {
+	err := os.Remove(s.path)
+	if os.IsNotExist(err) {
+		return nil
+	}
+	return err
+}
