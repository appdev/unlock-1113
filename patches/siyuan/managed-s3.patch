+import "testing"
+
+func TestQingYuDefaultAndLegacyProvider(t *testing.T) {
+	if sync := NewSync(); sync.Provider != ProviderS3 || !sync.ManagedStorage || sync.Enabled {
+		t.Fatal("new workspaces must default to signed-out QingYu with sync disabled")
+	}
+	legacy := NormalizeSync(&Sync{Provider: ProviderSiYuan, Enabled: true})
+	if legacy.Provider != ProviderS3 || !legacy.ManagedStorage || legacy.Enabled {
+		t.Fatal("official provider must migrate to paused QingYu")
+	}
+	manual := NormalizeSync(&Sync{Provider: ProviderS3, S3: &S3{Endpoint: "https://manual.example", Bucket: "notes"}})
+	if manual.ManagedStorage || manual.S3.Bucket != "notes" {
+		t.Fatal("existing manual S3 must retain its source and configuration")
+	}
+}
