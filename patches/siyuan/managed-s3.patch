+// SiYuan - https://github.com/siyuan-note/siyuan
+// Copyright (c) 2020-present, b3log.org
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+package model
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"io/fs"
+	"os"
+	"path/filepath"
+)
+
+func managedRepoKeyID(key []byte) string {
+	sum := sha256.Sum256(key)
+	return hex.EncodeToString(sum[:])
+}
+
+// Called under the sync/source lock. Never discard a repository to recover a
+// managed key: a missing local key alongside existing repo files requires repair.
+func (c *managedStorageClient) recoverRepoKeyLocked(ctx context.Context) ([]byte, error) {
+	local := Conf.Repo.Load().Key
+	if len(local) != 0 && len(local) != 32 {
+		return nil, managedError("repo_key_conflict")
+	}
+	if len(local) == 0 {
+		err := filepath.WalkDir(Conf.Repo.Load().GetSaveDir(), func(_ string, d fs.DirEntry, err error) error {
+			if os.IsNotExist(err) {
+				return nil
+			}
+			if err != nil {
+				return err
+			}
+			if !d.IsDir() {
+				return managedError("repo_key_conflict")
+			}
+			return nil
+		})
+		if err != nil {
+			return nil, managedError("repo_key_conflict")
+		}
+	}
+	var response struct {
+		Version   int    `json:"version"`
+		AccountID string `json:"accountId"`
+		Bucket    string `json:"bucket"`
+		RepoKey   string `json:"repoKey"`
+	}
+	if err := c.authorizedLocked(ctx, "POST", "repo-key", map[string]string{"repoKey": base64.StdEncoding.EncodeToString(local)}, &response); err != nil {
+		return nil, err
+	}
+	key, err := base64.StdEncoding.DecodeString(response.RepoKey)
+	if err != nil || len(key) != 32 || response.Version != 1 || response.AccountID != c.session.User.ID || response.Bucket != c.session.Storage.Bucket {
+		return nil, managedError("invalid_response")
+	}
+	if len(local) > 0 && !bytes.Equal(local, key) {
+		return nil, managedError("repo_key_conflict")
+	}
+	return key, nil
+}
