+	}
+	if content, err := os.ReadFile(filepath.Join(a.DataPath, "seed.txt")); err != nil || !bytes.Equal(content, []byte("managed source version two")) {
+		t.Fatal("round-trip edit content mismatch")
+	}
+
+	for i := 0; i < 35; i++ {
+		tag := fmt.Sprintf("managed-tag-%02d", i)
