diff --git a/kernel/model/managed_storage.go b/kernel/model/managed_storage.go
new file mode 100644
--- /dev/null
+++ b/kernel/model/managed_storage.go
@@ -0,0 +1,782 @@
+// SiYuan - https://github.com/siyuan-note/siyuan
+// Copyright (c) 2020-present, b3log.org
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+package model
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/siyuan-note/siyuan/kernel/conf"
+	"github.com/siyuan-note/siyuan/kernel/util"
+)
+
+// ManagedStorageOrigin 由发行配置提供；测试实例可通过环境变量指定隔离服务。
+var ManagedStorageOrigin string
+
+type ManagedStorageStatus struct {
+	Configured        bool   `json:"configured"`
+	Managed           bool   `json:"managed"`
+	LoggedIn          bool   `json:"loggedIn"`
+	SyncPending       bool   `json:"syncPending"`
+	SyncEnabled       bool   `json:"syncEnabled"`
+	Persistent        bool   `json:"persistent"`
+	State             string `json:"state"`
+	ErrorCode         string `json:"errorCode"`
+	Origin            string `json:"origin"`
+	AccountID         string `json:"accountId"`
+	Name              string `json:"name"`
+	EmailVerified     bool   `json:"emailVerified"`
+	Active            bool   `json:"active"`
+	ExpiresAt         string `json:"expiresAt"`
+	SessionExpiresAt  int64  `json:"sessionExpiresAt"`
+	QuotaBytes        int64  `json:"quotaBytes"`
+	UsedBytes         int64  `json:"usedBytes"`
+	Bucket            string `json:"bucket"`
+	Endpoint          string `json:"endpoint"`
+	RevocationPending bool   `json:"revocationPending"`
+}
+
+type managedStorageTokens struct {
+	AccessToken      string `json:"accessToken"`
+	RefreshToken     string `json:"refreshToken"`
+	TokenType        string `json:"tokenType"`
+	ExpiresAt        int64  `json:"expiresAt"`
+	SessionExpiresAt int64  `json:"sessionExpiresAt"`
+}
+
+type managedStorageUser struct {
+	ID            string `json:"id"`
+	Name          string `json:"name"`
+	DisplayName   string `json:"displayName"`
+	EmailVerified bool   `json:"emailVerified"`
+}
+
+type managedStorageSubscription struct {
+	Active        bool   `json:"active"`
+	EmailVerified bool   `json:"emailVerified"`
+	ExpiresAt     string `json:"expiresAt"`
+	QuotaBytes    int64  `json:"quotaBytes"`
+}
+
+type managedStorageConfig struct {
+	Endpoint            string `json:"endpoint"`
+	Region              string `json:"region"`
+	Bucket              string `json:"bucket"`
+	AccessKeyID         string `json:"accessKeyId"`
+	SecretAccessKey     string `json:"secretAccessKey"`
+	ForcePathStyle      bool   `json:"forcePathStyle"`
+	CredentialsExpireAt int64  `json:"credentialsExpireAt"`
+	MaxObjectBytes      int64  `json:"maxObjectBytes"`
+	ConcurrentReqs      int    `json:"concurrentReqs"`
+}
+
+type managedStorageSession struct {
+	Tokens          managedStorageTokens
+	User            managedStorageUser
+	Plan            managedStorageSubscription
+	Storage         *managedStorageConfig
+	Pending         []managedStorageTokens
+	LoggedOut       bool
+	Persistent      bool
+	AutoSyncPending bool
+	RepoKeyID       string
+}
+
+type managedStorageClient struct {
+	mu         sync.Mutex
+	origin     string
+	client     *http.Client
+	session    *managedStorageSession
+	store      *managedStorageStore
+	state      string
+	errCode    string
+	used       int64
+	retryTimer *time.Timer
+	retryDelay time.Duration
+}
+
+type managedStorageError struct{ code string }
+
+func (e *managedStorageError) Error() string { return e.code }
+
+func managedError(code string) error { return &managedStorageError{code: code} }
+
+var managedStorageClients sync.Map
+var managedStorageActionMu sync.Mutex
+
+func managedStorageServiceOrigin() (string, error) {
+	value := os.Getenv("SIYUAN_MANAGED_STORAGE_ORIGIN")
+	if value == "" {
+		value = ManagedStorageOrigin
+	}
+	u, err := url.Parse(strings.TrimRight(value, "/"))
+	if err != nil || u.Hostname() == "" || u.User != nil || u.RawQuery != "" || u.Fragment != "" || u.Path != "" ||
+		(u.Scheme != "https" && !(u.Scheme == "http" && os.Getenv("SIYUAN_MANAGED_STORAGE_ALLOW_HTTP") == "true")) {
+		return "", managedError("service_not_configured")
+	}
+	return u.String(), nil
+}
+
+func currentManagedStorageClient() (*managedStorageClient, error) {
+	origin, err := managedStorageServiceOrigin()
+	if err != nil {
+		return nil, err
+	}
+	key := util.WorkspaceDir + "\x00" + origin + "\x00" + util.HomeDir
+	if existing, ok := managedStorageClients.Load(key); ok {
+		return existing.(*managedStorageClient), nil
+	}
+	c := &managedStorageClient{origin: origin, state: "signed_out", client: &http.Client{
+		Timeout:       20 * time.Second,
+		CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse },
+	}}
+	if store, err := newManagedStorageStore(origin, false); err == nil {
+		var session managedStorageSession
+		if store.load(&session) == nil {
+			c.store, c.session = store, &session
+			c.state = "ready"
+			if session.LoggedOut {
+				c.state = "signed_out"
+			} else if session.Tokens.SessionExpiresAt <= time.Now().Unix() {
+				c.state = "session_expired"
+			}
+		}
+	}
+	actual, _ := managedStorageClients.LoadOrStore(key, c)
+	return actual.(*managedStorageClient), nil
+}
+
+// call 不返回远端正文和网络错误文本，避免凭证进入日志或通用错误响应。
+func (c *managedStorageClient) call(ctx context.Context, method, action, token string, input, output any) error {
+	var body io.Reader
+	if method == http.MethodPost {
+		if input == nil {
+			input = struct{}{}
+		}
+		data, err := json.Marshal(input)
+		if err != nil {
+			return managedError("invalid_request")
+		}
+		body = bytes.NewReader(data)
+	}
+	r, err := http.NewRequestWithContext(ctx, method, c.origin+"/api/client/v1/"+action, body)
+	if err != nil {
+		return managedError("service_unavailable")
+	}
+	r.Header.Set("Content-Type", "application/json")
+	if token != "" {
+		r.Header.Set("Authorization", "Bearer "+token)
+	}
+	response, err := c.client.Do(r)
+	if err != nil {
+		return managedError("service_unavailable")
+	}
+	defer response.Body.Close()
+	raw, err := io.ReadAll(io.LimitReader(response.Body, 65537))
+	var envelope struct {
+		Status string          `json:"status"`
+		Code   string          `json:"code"`
+		Data   json.RawMessage `json:"data"`
+	}
+	if err != nil || len(raw) > 65536 || json.Unmarshal(raw, &envelope) != nil {
+		return managedError("invalid_response")
+	}
+	if response.StatusCode < 200 || response.StatusCode >= 300 || envelope.Status != "ok" {
+		code := "service_unavailable"
+		switch envelope.Code {
+		case "login_failed", "invalid_token", "invalid_refresh_token", "email_unverified", "subscription_required", "storage_unavailable", "temporarily_unavailable", "repo_key_conflict", "repo_key_required":
+			code = envelope.Code
+		}
+		return managedError(code)
+	}
+	if output != nil && json.Unmarshal(envelope.Data, output) != nil {
+		return managedError("invalid_response")
+	}
+	return nil
+}
+
+func validManagedTokens(tokens managedStorageTokens) bool {
+	now := time.Now().Unix()
+	return tokens.AccessToken != "" && tokens.RefreshToken != "" && tokens.TokenType == "Bearer" &&
+		tokens.ExpiresAt > now && tokens.SessionExpiresAt >= tokens.ExpiresAt && tokens.SessionExpiresAt <= now+31*86400
+}
+
+func (c *managedStorageClient) saveLocked() {
+	if c.store == nil || c.session == nil {
+		return
+	}
+	if err := c.store.save(c.session); err != nil {
+		_ = c.store.remove()
+		c.session.Persistent = false
+		c.store = nil
+		c.errCode = "secure_storage_unavailable"
+	}
+}
+
+func (c *managedStorageClient) refreshLocked(ctx context.Context) error {
+	if c.session == nil || c.session.LoggedOut {
+		return managedError("login_required")
+	}
+	if c.session.Tokens.SessionExpiresAt <= time.Now().Unix() {
+		c.expireSessionLocked()
+		return managedError("invalid_refresh_token")
+	}
+	var tokens managedStorageTokens
+	err := c.call(ctx, "POST", "refresh", "", map[string]string{"refreshToken": c.session.Tokens.RefreshToken}, &tokens)
+	if err != nil {
+		if err.Error() == "invalid_refresh_token" {
+			c.expireSessionLocked()
+		}
+		return err
+	}
+	if !validManagedTokens(tokens) || tokens.SessionExpiresAt != c.session.Tokens.SessionExpiresAt {
+		return managedError("invalid_response")
+	}
+	c.session.Tokens = tokens
+	c.saveLocked()
+	return nil
+}
+
+func (c *managedStorageClient) expireSessionLocked() {
+	if c.session.Tokens.AccessToken != "" {
+		pending := c.session.Tokens
+		pending.RefreshToken = ""
+		c.session.Pending = append(c.session.Pending, pending)
+	}
+	if c.session.Storage != nil {
+		c.session.Storage.AccessKeyID, c.session.Storage.SecretAccessKey = "", ""
+	}
+	c.session.Tokens = managedStorageTokens{}
+	c.state, c.errCode = "session_expired", "invalid_refresh_token"
+	c.saveLocked()
+	c.scheduleRevocationLocked()
+}
+
+func (c *managedStorageClient) authorizedLocked(ctx context.Context, method, action string, input, output any) error {
+	if c.session == nil || c.session.LoggedOut {
+		return managedError("login_required")
+	}
+	refreshed := false
+	if c.session.Tokens.ExpiresAt <= time.Now().Unix()+30 {
+		if err := c.refreshLocked(ctx); err != nil {
+			return err
+		}
+		refreshed = true
+	}
+	err := c.call(ctx, method, action, c.session.Tokens.AccessToken, input, output)
+	if err != nil && err.Error() == "invalid_token" && !refreshed {
+		if err = c.refreshLocked(ctx); err != nil {
+			return err
+		}
+		return c.call(ctx, method, action, c.session.Tokens.AccessToken, input, output)
+	}
+	return err
+}
+
+func (c *managedStorageClient) validateStorage(storage *managedStorageConfig) error {
+	if storage == nil || storage.AccessKeyID == "" || storage.SecretAccessKey == "" || storage.Bucket == "" || storage.Region == "" ||
+		!storage.ForcePathStyle || storage.CredentialsExpireAt <= time.Now().Unix() || storage.CredentialsExpireAt > c.session.Tokens.SessionExpiresAt {
+		return managedError("invalid_response")
+	}
+	origin, _ := url.Parse(c.origin)
+	endpoint, err := url.Parse(storage.Endpoint)
+	if err != nil || endpoint.Scheme != origin.Scheme || endpoint.Host != origin.Host || endpoint.User != nil ||
+		endpoint.RawQuery != "" || endpoint.Fragment != "" || strings.TrimRight(endpoint.Path, "/") != "/s3" {
+		return managedError("invalid_response")
+	}
+	if storage.ConcurrentReqs < 1 || storage.ConcurrentReqs > 2 {
+		storage.ConcurrentReqs = 2
+	}
+	return nil
+}
+
+func (c *managedStorageClient) updateLocked(ctx context.Context, provision bool) error {
+	var user managedStorageUser
+	if err := c.authorizedLocked(ctx, "GET", "me", nil, &user); err != nil {
+		return err
+	}
+	if user.ID == "" || c.session.User.ID != "" && user.ID != c.session.User.ID {
+		return managedError("invalid_response")
+	}
+	var plan managedStorageSubscription
+	if err := c.authorizedLocked(ctx, "GET", "subscription", nil, &plan); err != nil {
+		return err
+	}
+	c.session.User, c.session.Plan = user, plan
+	if !user.EmailVerified || !plan.EmailVerified {
+		c.state = "email_unverified"
+		return nil
+	}
+	if !plan.Active {
+		c.state = "subscription_required"
+		return nil
+	}
+	if provision && c.session.Storage == nil {
+		var storage managedStorageConfig
+		if err := c.authorizedLocked(ctx, "POST", "storage-config", nil, &storage); err != nil {
+			return err
+		}
+		if err := c.validateStorage(&storage); err != nil {
+			return err
+		}
+		c.session.Storage = &storage
+	}
+	c.state = "ready"
+	if c.session.Storage == nil {
+		c.state = "storage_pending"
+	}
+	c.saveLocked()
+	return nil
+}
+
+func managedStorageMode() bool {
+	return Conf != nil && Conf.Sync.Load() != nil && Conf.Sync.Load().ManagedStorage
+}
+
+func (c *managedStorageClient) statusLocked() ManagedStorageStatus {
+	s := ManagedStorageStatus{Configured: true, Origin: c.origin, Managed: managedStorageMode(), State: c.state, ErrorCode: c.errCode}
+	s.SyncEnabled = s.Managed && Conf.Sync.Load().Provider == conf.ProviderS3 && Conf.Sync.Load().Enabled
+	if c.session == nil {
+		return s
+	}
+	s.SyncPending = c.session.AutoSyncPending && !c.session.LoggedOut && s.Managed
+	s.Persistent = c.session.Persistent
+	s.RevocationPending = len(c.session.Pending) != 0
+	if c.session.LoggedOut {
+		return s
+	}
+	s.LoggedIn = c.session.Tokens.RefreshToken != ""
+	s.AccountID, s.Name = c.session.User.ID, c.session.User.DisplayName
+	if s.Name == "" {
+		s.Name = c.session.User.Name
+	}
+	s.EmailVerified, s.Active = c.session.User.EmailVerified, c.session.Plan.Active
+	s.ExpiresAt, s.QuotaBytes, s.UsedBytes = c.session.Plan.ExpiresAt, c.session.Plan.QuotaBytes, c.used
+	s.SessionExpiresAt = c.session.Tokens.SessionExpiresAt
+	if storage := c.session.Storage; storage != nil {
+		s.Bucket, s.Endpoint = storage.Bucket, storage.Endpoint
+	}
+	return s
+}
+
+func GetManagedStorageStatus(ctx context.Context, refresh bool) ManagedStorageStatus {
+	c, err := currentManagedStorageClient()
+	if err != nil {
+		return ManagedStorageStatus{State: "unconfigured", ErrorCode: err.Error(), Managed: managedStorageMode()}
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.revokePendingLocked(ctx)
+	if refresh && c.session != nil && !c.session.LoggedOut {
+		if err = c.updateLocked(ctx, false); err != nil {
+			c.errCode = err.Error()
+			if c.state != "session_expired" {
+				c.state = "offline"
+			}
+		} else {
+			c.errCode = ""
+			if c.state == "ready" {
+				var usage struct {
+					UsedBytes int64 `json:"usedBytes"`
+				}
+				if c.authorizedLocked(ctx, "GET", "usage", nil, &usage) == nil {
+					c.used = usage.UsedBytes
+				}
+			}
+		}
+	}
+	return c.statusLocked()
+}
+
+func LoginManagedStorage(ctx context.Context, username, password string, remember bool) (ManagedStorageStatus, error) {
+	return loginManagedStorage(ctx, username, password, remember, false)
+}
+
+func LoginManagedStorageAndStart(ctx context.Context, username, password string, remember bool) (ManagedStorageStatus, error) {
+	return loginManagedStorage(ctx, username, password, remember, true)
+}
+
+func loginManagedStorage(ctx context.Context, username, password string, remember, enableSync bool) (ManagedStorageStatus, error) {
+	managedStorageActionMu.Lock()
+	defer managedStorageActionMu.Unlock()
+	current, err := currentManagedStorageClient()
+	if err != nil {
+		return ManagedStorageStatus{}, err
+	}
+	originalSync := Conf.Sync.Load()
+	candidate := &managedStorageClient{origin: current.origin, client: current.client, state: "signed_out", session: &managedStorageSession{}}
+	if err = candidate.call(ctx, "POST", "login", "", map[string]string{"username": username, "password": password}, &candidate.session.Tokens); err != nil {
+		return GetManagedStorageStatus(ctx, false), err
+	}
+	committed := false
+	defer func() {
+		if !committed && candidate.session.Tokens.AccessToken != "" {
+			cleanup, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+			defer cancel()
+			current.mu.Lock()
+			defer current.mu.Unlock()
+			if current.session == nil {
+				current.session = &managedStorageSession{LoggedOut: true}
+			}
+			current.session.Pending = append(current.session.Pending, candidate.session.Tokens)
+			current.revokePendingLocked(cleanup)
+		}
+	}()
+	if !validManagedTokens(candidate.session.Tokens) {
+		return GetManagedStorageStatus(ctx, false), managedError("invalid_response")
+	}
+	if err = candidate.updateLocked(ctx, true); err != nil {
+		return GetManagedStorageStatus(ctx, false), err
+	}
+	release := lockAssetSourceChange()
+	defer release()
+	if Conf.Sync.Load() != originalSync {
+		return GetManagedStorageStatus(ctx, false), managedError("configuration_changed")
+	}
+	if err = requireCompleteAssetDownloads(); err != nil {
+		return GetManagedStorageStatus(ctx, false), managedError("source_incomplete")
+	}
+	if ctx.Err() != nil {
+		return GetManagedStorageStatus(context.Background(), false), managedError("cancelled")
+	}
+	var recoveredKey []byte
+	if enableSync && candidate.session.Storage != nil {
+		recoveredKey, err = candidate.recoverRepoKeyLocked(ctx)
+		if err != nil {
+			return GetManagedStorageStatus(ctx, false), err
+		}
+		if ctx.Err() != nil {
+			return GetManagedStorageStatus(context.Background(), false), managedError("cancelled")
+		}
+		candidate.session.RepoKeyID = managedRepoKeyID(recoveredKey)
+	}
+	if Conf.Sync.Load() != originalSync {
+		return GetManagedStorageStatus(ctx, false), managedError("configuration_changed")
+	}
+	current.mu.Lock()
+	if candidate.session.Storage == nil && managedStorageMode() && current.session != nil && !current.session.LoggedOut && candidate.session.User.ID != current.session.User.ID {
+		status := current.statusLocked()
+		current.mu.Unlock()
+		return status, managedError("storage_unavailable")
+	}
+	if current.session != nil {
+		candidate.session.Pending = append(candidate.session.Pending, current.session.Pending...)
+		if !current.session.LoggedOut && current.session.Tokens.RefreshToken != "" {
+			candidate.session.Pending = append(candidate.session.Pending, current.session.Tokens)
+		}
+	}
+	if remember {
+		if store, storeErr := newManagedStorageStore(current.origin, true); storeErr == nil {
+			candidate.store, candidate.session.Persistent = store, true
+		} else {
+			candidate.errCode = "secure_storage_unavailable"
+		}
+	}
+	if current.store != nil && candidate.store == nil {
+		_ = current.store.remove()
+	}
+	if len(recoveredKey) > 0 && len(Conf.Repo.Load().Key) == 0 {
+		UpdateRepoConf(func(r *conf.Repo) { r.Key = append([]byte(nil), recoveredKey...) })
+	}
+	if len(recoveredKey) > 0 && !bytes.Equal(Conf.Repo.Load().Key, recoveredKey) {
+		status := current.statusLocked()
+		current.mu.Unlock()
+		return status, managedError("repo_key_conflict")
+	}
+	current.session, current.store = candidate.session, candidate.store
+	current.state, current.errCode = candidate.state, candidate.errCode
+	current.session.AutoSyncPending = enableSync && candidate.session.Storage != nil
+	start := current.session.AutoSyncPending && len(Conf.Repo.Load().Key) > 0
+	if start {
+		current.session.AutoSyncPending = false
+	}
+	current.saveLocked()
+	if candidate.session.Storage != nil {
+		UpdateSyncConf(func(s *conf.Sync) {
+			s.ManagedStorage = true
+			s.Provider = conf.ProviderS3
+			if start {
+				s.Enabled = true
+			}
+		})
+		if start {
+			planSyncAfter(0)
+		}
+	}
+	committed = true
+	current.revokePendingLocked(ctx)
+	status := current.statusLocked()
+	current.mu.Unlock()
+	release()
+	refreshLANSyncManager()
+	return status, nil
+}
+
+func (c *managedStorageClient) revokePendingLocked(ctx context.Context) {
+	if c.session == nil || len(c.session.Pending) == 0 {
+		return
+	}
+	remaining := c.session.Pending[:0]
+	for _, tokens := range c.session.Pending {
+		if tokens.SessionExpiresAt <= time.Now().Unix() {
+			continue
+		}
+		if tokens.RefreshToken == "" && tokens.ExpiresAt <= time.Now().Unix() {
+			remaining = append(remaining, tokens)
+			continue
+		}
+		err := c.call(ctx, "POST", "logout", tokens.AccessToken, nil, nil)
+		if err != nil && err.Error() == "invalid_token" {
+			var next managedStorageTokens
+			err = c.call(ctx, "POST", "refresh", "", map[string]string{"refreshToken": tokens.RefreshToken}, &next)
+			if err == nil && validManagedTokens(next) {
+				tokens = next
+				err = c.call(ctx, "POST", "logout", tokens.AccessToken, nil, nil)
+			} else if err == nil {
+				err = managedError("invalid_response")
+				tokens.RefreshToken = ""
+			} else if err.Error() == "invalid_refresh_token" {
+				tokens.RefreshToken = ""
+			}
+		}
+		if err != nil {
+			remaining = append(remaining, tokens)
+		}
+	}
+	c.session.Pending = remaining
+	if c.session.LoggedOut && len(remaining) == 0 && c.store != nil {
+		_ = c.store.remove()
+	} else {
+		c.saveLocked()
+	}
+	c.scheduleRevocationLocked()
+}
+
+func (c *managedStorageClient) scheduleRevocationLocked() {
+	if c.session == nil || len(c.session.Pending) == 0 {
+		if c.retryTimer != nil {
+			c.retryTimer.Stop()
+			c.retryTimer = nil
+		}
+		c.retryDelay = 0
+		return
+	}
+	if c.retryTimer != nil {
+		return
+	}
+	if c.retryDelay == 0 {
+		c.retryDelay = 30 * time.Second
+	} else if c.retryDelay < 5*time.Minute {
+		c.retryDelay = min(c.retryDelay*2, 5*time.Minute)
+	}
+	c.retryTimer = time.AfterFunc(c.retryDelay, func() {
+		c.mu.Lock()
+		defer c.mu.Unlock()
+		c.retryTimer = nil
+		ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+		defer cancel()
+		c.revokePendingLocked(ctx)
+	})
+}
+
+func LogoutManagedStorage(ctx context.Context) (ManagedStorageStatus, error) {
+	managedStorageActionMu.Lock()
+	defer managedStorageActionMu.Unlock()
+	release := lockAssetSourceChange()
+	defer release()
+	if managedStorageMode() {
+		if err := requireCompleteAssetDownloads(); err != nil {
+			return GetManagedStorageStatus(ctx, false), managedError("source_incomplete")
+		}
+	}
+	c, err := currentManagedStorageClient()
+	if err != nil {
+		return ManagedStorageStatus{}, err
+	}
+	c.mu.Lock()
+	if c.session != nil && !c.session.LoggedOut {
+		c.session.Pending = append(c.session.Pending, c.session.Tokens)
+		c.session.Tokens, c.session.User, c.session.Plan = managedStorageTokens{}, managedStorageUser{}, managedStorageSubscription{}
+		c.session.Storage, c.session.LoggedOut = nil, true
+		c.saveLocked()
+	}
+	if managedStorageMode() && Conf.Sync.Load().Provider == conf.ProviderS3 {
+		UpdateSyncConf(func(s *conf.Sync) { s.Enabled = false })
+	}
+	c.state, c.errCode, c.used = "signed_out", "", 0
+	c.revokePendingLocked(ctx)
+	status := c.statusLocked()
+	c.mu.Unlock()
+	release()
+	refreshLANSyncManager()
+	return status, nil
+}
+
+func SetManagedStorageMode(ctx context.Context, managed bool) (ManagedStorageStatus, error) {
+	managedStorageActionMu.Lock()
+	defer managedStorageActionMu.Unlock()
+	release := lockAssetSourceChange()
+	defer release()
+	if managed != managedStorageMode() {
+		if err := requireCompleteAssetDownloads(); err != nil {
+			return GetManagedStorageStatus(ctx, false), managedError("source_incomplete")
+		}
+	}
+	if managed {
+		c, err := currentManagedStorageClient()
+		if err != nil {
+			return GetManagedStorageStatus(ctx, false), err
+		}
+		c.mu.Lock()
+		err = c.updateLocked(ctx, true)
+		c.mu.Unlock()
+		if err != nil {
+			return GetManagedStorageStatus(ctx, false), err
+		}
+		if _, err := effectiveManagedStorageS3(); err != nil {
+			return GetManagedStorageStatus(ctx, false), err
+		}
+	}
+	UpdateSyncConf(func(s *conf.Sync) { s.ManagedStorage = managed })
+	release()
+	refreshLANSyncManager()
+	return GetManagedStorageStatus(ctx, false), nil
+}
+
+// StartManagedStorageSync 只启用仍被选中的同一账号，迟到的界面操作不能启用其他来源。
+func StartManagedStorageSync(ctx context.Context, accountID string) (ManagedStorageStatus, error) {
+	managedStorageActionMu.Lock()
+	defer managedStorageActionMu.Unlock()
+	defer refreshLANSyncManager()
+	release := lockAssetSourceChange()
+	defer release()
+	c, err := currentManagedStorageClient()
+	if err != nil {
+		return ManagedStorageStatus{}, err
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if Conf.Sync.Load().Provider != conf.ProviderS3 || !managedStorageMode() || accountID == "" ||
+		c.session == nil || c.session.LoggedOut || c.session.User.ID != accountID {
+		return c.statusLocked(), managedError("configuration_changed")
+	}
+	if err = c.updateLocked(ctx, false); err != nil {
+		return c.statusLocked(), err
+	}
+	if c.state != "ready" || c.session.Storage == nil {
+		return c.statusLocked(), managedError("storage_unavailable")
+	}
+	key, err := c.recoverRepoKeyLocked(ctx)
+	if err != nil {
+		return c.statusLocked(), err
+	}
+	if ctx.Err() != nil {
+		return c.statusLocked(), managedError("cancelled")
+	}
+	if len(Conf.Repo.Load().Key) == 0 {
+		UpdateRepoConf(func(r *conf.Repo) { r.Key = append([]byte(nil), key...) })
+	}
+	c.session.RepoKeyID = managedRepoKeyID(key)
+	UpdateSyncConf(func(s *conf.Sync) { s.Enabled = true })
+	c.session.AutoSyncPending = false
+	c.saveLocked()
+	planSyncAfter(0)
+	return c.statusLocked(), nil
+}
+
+func effectiveManagedStorageS3() (*conf.S3, error) {
+	c, err := currentManagedStorageClient()
+	if err != nil {
+		return nil, err
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.session == nil || c.session.LoggedOut || c.session.Storage == nil || c.session.Tokens.RefreshToken == "" {
+		return nil, managedError("login_required")
+	}
+	if c.session.RepoKeyID != "" && c.session.RepoKeyID != managedRepoKeyID(Conf.Repo.Load().Key) {
+		return nil, managedError("repo_key_conflict")
+	}
+	if c.session.Tokens.SessionExpiresAt <= time.Now().Unix() || c.session.Storage.CredentialsExpireAt <= time.Now().Unix() {
+		return nil, managedError("session_expired")
+	}
+	if !c.session.User.EmailVerified {
+		return nil, managedError("email_unverified")
+	}
+	expires, err := time.Parse(time.RFC3339, c.session.Plan.ExpiresAt)
+	if err != nil || !c.session.Plan.Active || !expires.After(time.Now()) {
+		return nil, managedError("subscription_required")
+	}
+	storage := c.session.Storage
+	return &conf.S3{Endpoint: storage.Endpoint, AccessKey: storage.AccessKeyID, SecretKey: storage.SecretAccessKey,
+		Bucket: storage.Bucket, Region: storage.Region, PathStyle: true, Timeout: 60, ConcurrentReqs: storage.ConcurrentReqs}, nil
+}
+
+func effectiveSyncS3() (*conf.S3, error) {
+	if managedStorageMode() {
+		return effectiveManagedStorageS3()
+	}
+	if Conf == nil || Conf.Sync.Load() == nil {
+		return nil, errors.New("sync_unavailable")
+	}
+	return cloneConfSection(Conf.Sync.Load().S3), nil
+}
+
+// 在原同步/来源锁内只刷新当前设备的账号摘要，不获取来源锁，也不清除本地解锁身份。
+func managedStorageRepoErrorHandler() func(error) {
+	c, err := currentManagedStorageClient()
+	if err != nil {
+		return func(error) {}
+	}
+	c.mu.Lock()
+	session := c.session
+	c.mu.Unlock()
+	var once sync.Once
+	return func(err error) {
+		var response interface{ HTTPStatusCode() int }
+		if !errors.As(err, &response) || response.HTTPStatusCode() != http.StatusForbidden {
+			return
+		}
+		once.Do(func() {
+			c.mu.Lock()
+			defer c.mu.Unlock()
+			if c.session == nil || c.session != session || c.session.LoggedOut {
+				return
+			}
+			ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+			defer cancel()
+			if err := c.updateLocked(ctx, false); err != nil {
+				c.errCode = err.Error()
+				if c.state != "session_expired" {
+					c.state = "offline"
+				}
+			} else {
+				c.errCode = ""
+			}
+		})
+	}
+}
+
+// 失效来源仅提供非敏感仓库定位，保证本地快照可创建；远程入口仍要求有效设备凭证。
+func managedStorageIdentityS3() *conf.S3 {
+	s3 := &conf.S3{Region: "us-east-1", PathStyle: true, Timeout: 60, ConcurrentReqs: 2}
+	if c, err := currentManagedStorageClient(); err == nil {
+		c.mu.Lock()
+		defer c.mu.Unlock()
+		if c.session != nil && c.session.Storage != nil {
+			s3.Endpoint, s3.Bucket, s3.Region = c.session.Storage.Endpoint, c.session.Storage.Bucket, c.session.Storage.Region
+		}
+	}
+	return s3
+}
