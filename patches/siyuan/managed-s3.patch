@@ -0,0 +1,63 @@
+// SiYuan - https://github.com/siyuan-note/siyuan
+// Copyright (c) 2020-present, b3log.org
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+package api
+
+import (
+	"errors"
+	"github.com/gin-gonic/gin"
+	"github.com/siyuan-note/siyuan/kernel/apicontract"
+	"github.com/siyuan-note/siyuan/kernel/model"
+)
+
+var getManagedStorageStatus = contractHandler(apicontract.GetManagedStorageStatus, func(c *gin.Context, request apicontract.ManagedStorageStatusRequest) apicontract.Response[apicontract.ManagedStorageStatus] {
+	c.Header("Cache-Control", "no-store")
+	return apicontract.Success(apicontract.ManagedStorageStatus(model.GetManagedStorageStatus(c.Request.Context(), request.Refresh)))
+})
+
+var loginManagedStorage = contractHandler(apicontract.LoginManagedStorage, func(c *gin.Context, request apicontract.ManagedStorageLoginRequest) apicontract.Response[apicontract.ManagedStorageStatus] {
+	c.Header("Cache-Control", "no-store")
+	if request.Username == "" || request.Password == "" || len(request.Username) > 256 || len(request.Password) > 4096 {
+		return apicontract.LoginManagedStorage.FailureWithData(-1, "invalid_request", apicontract.ManagedStorageStatus(model.GetManagedStorageStatus(c.Request.Context(), false)))
+	}
+	var status model.ManagedStorageStatus
+	var err error
+	if request.EnableSync {
+		status, err = model.LoginManagedStorageAndStart(c.Request.Context(), request.Username, request.Password, request.Remember)
+	} else {
+		status, err = model.LoginManagedStorage(c.Request.Context(), request.Username, request.Password, request.Remember)
+	}
+	if err != nil {
+		return apicontract.LoginManagedStorage.FailureWithData(-1, err.Error(), apicontract.ManagedStorageStatus(status))
+	}
+	return apicontract.Success(apicontract.ManagedStorageStatus(status))
+})
+
+var logoutManagedStorage = contractHandler(apicontract.LogoutManagedStorage, func(c *gin.Context, request apicontract.EmptyRequest) apicontract.Response[apicontract.ManagedStorageStatus] {
+	c.Header("Cache-Control", "no-store")
+	status, err := model.LogoutManagedStorage(c.Request.Context())
+	if err != nil {
+		return apicontract.LogoutManagedStorage.FailureWithData(-1, err.Error(), apicontract.ManagedStorageStatus(status))
+	}
+	return apicontract.Success(apicontract.ManagedStorageStatus(status))
+})
+
+var setManagedStorageMode = contractHandler(apicontract.SetManagedStorageMode, func(c *gin.Context, request apicontract.ManagedStorageModeRequest) apicontract.Response[apicontract.ManagedStorageStatus] {
+	c.Header("Cache-Control", "no-store")
+	var status model.ManagedStorageStatus
+	var err error
+	if request.EnableSync {
+		if !request.Managed {
+			err = errors.New("invalid_request")
+		} else {
+			status, err = model.StartManagedStorageSync(c.Request.Context(), request.AccountID)
+		}
+	} else {
+		status, err = model.SetManagedStorageMode(c.Request.Context(), request.Managed)
+	}
+	if err != nil {
+		return apicontract.SetManagedStorageMode.FailureWithData(-1, err.Error(), apicontract.ManagedStorageStatus(status))
+	}
+	return apicontract.Success(apicontract.ManagedStorageStatus(status))
+})
