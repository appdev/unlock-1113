diff --git a/app/src/config/tabs/managedStorage.test.ts b/app/src/config/tabs/managedStorage.test.ts
new file mode 100644
--- /dev/null
+++ b/app/src/config/tabs/managedStorage.test.ts
@@ -0,0 +1,92 @@
+import * as assert from "node:assert/strict";
+import {readFileSync} from "node:fs";
+import {test} from "node:test";
+import {runInNewContext} from "node:vm";
+import {ModuleKind, transpileModule} from "typescript";
+import {escapeHtmlTextAndAttr} from "../../util/escape";
+
+const setup = (hasKey: boolean, rejectLogin = false) => {
+    const code = transpileModule(readFileSync("src/config/tabs/managedStorage.ts", "utf8"), {
+        compilerOptions: {module: ModuleKind.CommonJS},
+    }).outputText;
+    const sync = {provider: 2, managedStorage: true, enabled: false};
+    const config = {sync, repo: {key: hasKey ? "existing-official-key" : ""}, readonly: false};
+    const fields = {username: {value: ""}, password: {value: ""}, remember: {checked: false}};
+    let submit: (event: unknown) => void;
+    let html = "";
+    const form = {querySelector: (selector: string) => {
+        const name = selector.slice(7, -2);
+        return name === "username" ? fields.username : name === "password" ? fields.password : fields.remember;
+    },
+        addEventListener: (_event: string, callback: typeof submit) => { submit = callback; }};
+    const panel = {
+        isConnected: true,
+        get innerHTML() { return html; },
+        set innerHTML(value: string) { html = value; },
+        querySelector: () => html.includes("data-managed-login") ? form : null,
+        querySelectorAll: (): never[] => [],
+    };
+    const toggle = {checked: false};
+    const root = {querySelector: (selector: string) => selector === "[data-managed-storage]" ? panel :
+        selector === '[id="sync.enabled"]' ? toggle : null};
+    const requests: {url: string; data: any}[] = [];
+    const signedOut = {configured: true, managed: true, loggedIn: false, state: "signed_out", origin: "https://fixture.invalid", syncEnabled: false};
+    const ready = {...signedOut, state: "ready", loggedIn: true, name: "fixture", accountId: "fixture-account", active: true, syncPending: false, syncEnabled: true};
+    const exports = {} as {mountManagedStorage: (root: unknown, changed: () => void) => void;
+        resumeManagedStorageSync: (root: unknown) => Promise<void>};
+    runInNewContext(code, {
+        exports, AbortController, Date,
+        window: {siyuan: {config, languages: new Proxy({}, {get: (_target, key) => String(key)})}},
+        document: {body: {}},
+        MutationObserver: class { observe() {} disconnect() {} },
+        require: (name: string) => {
+            if (name === "../../util/escape") return {escapeHtmlTextAndAttr};
+            if (name === "../../dialog/confirmDialog") return {confirmDialog: (_title: string, _body: string, yes: () => void) => yes()};
+            if (name === "../../util/fetch") return {fetchSyncPost: async (url: string, data: any) => {
+                requests.push({url, data});
+                if (url.endsWith("getManagedStorageStatus")) return {code: 0, data: signedOut};
+                if (url.endsWith("loginManagedStorage") && rejectLogin) return {code: -1, msg: "login_failed"};
+                if (url.endsWith("loginManagedStorage")) config.sync.enabled = true;
+                if (url.endsWith("setManagedStorageMode")) { ready.syncEnabled = true; ready.syncPending = false; }
+                return {code: 0, data: ready};
+            }};
+            return {};
+        },
+    });
+    exports.mountManagedStorage(root, () => {});
+    return {config, requests, panel, toggle, exports, root, login: () => {
+        fields.username.value = "fixture-user";
+        fields.password.value = "synthetic-fixture-password";
+        submit({preventDefault() {}, currentTarget: form});
+    }};
+};
+
+const settle = () => new Promise<void>(resolve => setImmediate(resolve));
+
+test("login starts QingYu automatically with an existing official key", async () => {
+    const ui = setup(true);
+    await settle(); ui.login(); await settle();
+    assert.equal(ui.config.sync.enabled, true);
+    assert.equal(ui.toggle.checked, true);
+    const request = ui.requests.find(item => item.url.endsWith("loginManagedStorage"));
+    assert.equal(request.data.enableSync, true);
+    assert.equal(ui.requests.some(item => item.url.endsWith("setManagedStorageMode")), false);
+});
+
+test("first device signs in and starts sync without asking for a repository key", async () => {
+    const ui = setup(false);
+    await settle(); ui.login(); await settle();
+    assert.equal(ui.config.sync.enabled, true);
+    assert.equal(ui.requests.some(item => item.url.endsWith("setManagedStorageMode")), false);
+    assert.doesNotMatch(ui.panel.innerHTML, /data-managed-action="(?:importKey|initKey)"/);
+    assert.equal(ui.toggle.checked, true);
+});
+
+test("failed login never starts sync or saves the entered password", async () => {
+    const ui = setup(true, true);
+    await settle(); ui.login(); await settle();
+    assert.equal(ui.config.sync.enabled, false);
+    assert.equal(ui.requests.some(item => item.url.endsWith("setManagedStorageMode")), false);
+    assert.match(ui.panel.innerHTML, /managedStorageInvalidLogin/);
+    assert.doesNotMatch(ui.panel.innerHTML, /synthetic-fixture-password/);
+});
diff --git a/app/src/config/tabs/managedStorage.ts b/app/src/config/tabs/managedStorage.ts
new file mode 100644
--- /dev/null
+++ b/app/src/config/tabs/managedStorage.ts
@@ -0,0 +1,269 @@
+import {fetchSyncPost} from "../../util/fetch";
+import {escapeHtmlTextAndAttr} from "../../util/escape";
+import {confirmDialog} from "../../dialog/confirmDialog";
+import type {APIPOSTRoutes, APITransportError, ManagedStorageStatus} from "../../types/api";
+
+type ActionResult = APIPOSTRoutes["/api/sync/loginManagedStorage"]["response"] | APITransportError;
+
+const activePanels = new WeakMap<Element, AbortController>();
+const pendingSyncStarts = new WeakMap<Element, string>();
+const setupCallbacks = new WeakMap<Element, () => Promise<void>>();
+
+export const resumeManagedStorageSync = async (root: Element) => {
+    await setupCallbacks.get(root)?.();
+};
+
+export const mountManagedStorage = (root: Element, onChange: () => void) => {
+    const panel = root.querySelector<HTMLElement>("[data-managed-storage]");
+    if (!panel) {
+        return;
+    }
+    activePanels.get(panel)?.abort();
+    const controller = new AbortController();
+    activePanels.set(panel, controller);
+    let status: ManagedStorageStatus | undefined;
+    let busy = false;
+    let error = "";
+    let usernameValue = "";
+    let rememberDevice = true;
+    let starting = false;
+    const L = window.siyuan.languages;
+    const escape = escapeHtmlTextAndAttr;
+    const mounted = () => !controller.signal.aborted && panel.isConnected && window.siyuan.config.sync.provider === 2 && !!window.siyuan.config.sync.managedStorage;
+    const observer = new MutationObserver(() => {
+        if (!panel.isConnected) {
+            controller.abort();
+            observer.disconnect();
+        }
+    });
+    observer.observe(document.body, {childList: true, subtree: true});
+
+    const errorText = (code: string) => {
+        switch (code) {
+            case "login_failed": return L.managedStorageInvalidLogin;
+            case "key_required": return L.syncConfGuide1;
+            case "repo_key_conflict":
+            case "repo_key_required": return L.managedStorageKeyConflict;
+            case "email_unverified": return L.managedStorageEmailUnverified;
+            case "subscription_required": return L.managedStoragePlanRequired;
+            case "invalid_token":
+            case "invalid_refresh_token":
+            case "login_required":
+            case "session_expired": return L.managedStorageSessionExpired;
+            case "source_incomplete": return L.managedStorageSourceIncomplete;
+            case "secure_storage_unavailable": return L.managedStorageMemoryOnly;
+            case "configuration_changed":
+            case "cancelled": return L.managedStorageConfigurationChanged;
+            case "service_not_configured": return L.managedStorageUnconfigured;
+            default: return L.managedStorageUnavailable;
+        }
+    };
+
+    const stateText = () => {
+        switch (status?.state) {
+            case "ready": return L.managedStorageReady;
+            case "email_unverified": return L.managedStorageEmailUnverified;
+            case "subscription_required": return L.managedStoragePlanRequired;
+            case "session_expired": return L.managedStorageSessionExpired;
+            case "offline": return L.managedStorageUnavailable;
+            case "storage_pending": return L.managedStoragePending;
+            case "unconfigured": return L.managedStorageUnconfigured;
+            default: return L.managedStorageSignedOut;
+        }
+    };
+
+    const updateStatus = (next: ManagedStorageStatus) => {
+        status = next;
+        if (next.syncPending && next.loggedIn) pendingSyncStarts.set(root, next.accountId);
+        else pendingSyncStarts.delete(root);
+        window.siyuan.config.sync.managedStorage = next.managed;
+        if (next.managed) {
+            window.siyuan.config.sync.enabled = next.syncEnabled;
+            const toggle = root.querySelector<HTMLInputElement>('[id="sync.enabled"]');
+            if (toggle) toggle.checked = next.syncEnabled;
+        }
+        root.querySelector("#syncProviderConfigRow")?.classList.toggle("fn__none", next.managed);
+    };
+
+    const render = () => {
+        if (!mounted()) {
+            return;
+        }
+        const disabled = busy || starting || window.siyuan.config.readonly ? " disabled" : "";
+        const configured = status?.configured;
+        const account = status?.loggedIn ? `<div class="b3-label__text">${escape(status.name)}</div>` : "";
+        const usage = status?.active && status.quotaBytes > 0 ? `<div class="b3-label__text">${escape(L.managedStorageUsage)}: ${(status.usedBytes / 1e9).toFixed(3)} / ${(status.quotaBytes / 1e9).toFixed(1)} GB</div>` : "";
+        const expiration = status?.expiresAt && Date.parse(status.expiresAt) > 0 ? `<div class="b3-label__text">${escape(L.managedStorageExpires)}: ${escape(new Date(status.expiresAt).toLocaleDateString())}</div>` : "";
+        const warning = error || (status?.errorCode ? errorText(status.errorCode) : "");
+        const persistence = status?.loggedIn && !status.persistent ? `<div class="b3-label__text">${escape(L.managedStorageMemoryOnly)}</div>` : "";
+        const revocation = status?.revocationPending ? `<div class="b3-label__text">${escape(L.managedStorageLogoutPending)}</div>` : "";
+        panel.innerHTML = `<div>
+    <div class="b3-label__text">${escape(L.managedStorageIntro)}</div>
+    <div class="fn__hr"></div>
+    <div role="status" data-managed-status>${escape(stateText())}</div>${account}${usage}${expiration}${persistence}${revocation}
+    <div class="ft__error" data-managed-error role="alert">${escape(warning)}</div>
+    ${status?.state === "ready" && !window.siyuan.config.sync.enabled ? `<div data-managed-setup><div class="fn__hr"></div>
+        <button class="b3-button" type="button" data-managed-action="start"${disabled}>${escape(L.openSyncTip1)}</button>
+    </div>` : ""}
+    ${configured && !status?.loggedIn ? `<form data-managed-login>
+        <div class="fn__hr"></div>
+        <label>${escape(L.managedStorageUsername)}<input class="b3-text-field fn__block" name="username" value="${escape(usernameValue)}" autocomplete="username" required spellcheck="false" maxlength="256"${disabled}></label>
+        <div class="fn__hr"></div>
+        <label>${escape(L.password)}<input class="b3-text-field fn__block" type="password" name="password" autocomplete="current-password" required maxlength="4096"${disabled}></label>
+        <div class="fn__hr"></div>
+        <label><input type="checkbox" name="remember"${rememberDevice ? " checked" : ""}${disabled}> ${escape(L.managedStorageRemember)}</label>
+        <div class="fn__hr"></div>
+        <button class="b3-button" type="submit"${disabled}>${escape(L.managedStorageLogin)}</button>
+    </form>` : ""}
+    <div class="fn__hr"></div>
+    <div class="fn__flex fn__flex-wrap">
+        ${status?.loggedIn ? `<button class="b3-button b3-button--outline" type="button" data-managed-action="refresh"${disabled}>${escape(L.managedStorageRefresh)}</button><span class="fn__space"></span>
+        <button class="b3-button b3-button--outline" type="button" data-managed-action="logout"${disabled}>${escape(L.managedStorageLogout)}</button>` : ""}
+    </div>
+    <details><summary class="b3-label__text">${escape(L.more)}</summary>
+    ${configured ? `<div class="fn__hr"></div><div class="b3-label__text">
+        <a href="${escape(status.origin + "/signup/app-customers")}" target="_blank" rel="noopener noreferrer">${escape(L.managedStorageRegister)}</a> ·
+        <a href="${escape(status.origin + "/forget/app-customers")}" target="_blank" rel="noopener noreferrer">${escape(L.managedStorageRecover)}</a> ·
+        <a href="${escape(status.origin + "/purchase")}" target="_blank" rel="noopener noreferrer">${escape(L.managedStorageAccount)}</a>
+    </div>` : ""}
+    <div class="fn__hr"></div><div class="b3-label__text">${escape(L.managedStorageKeyTip)}</div>
+</details>
+</div>`;
+        panel.querySelector<HTMLFormElement>("[data-managed-login]")?.addEventListener("submit", event => {
+            event.preventDefault();
+            if (busy || window.siyuan.config.readonly) {
+                return;
+            }
+            const form = event.currentTarget as HTMLFormElement;
+            const username = form.querySelector<HTMLInputElement>('[name="username"]');
+            const password = form.querySelector<HTMLInputElement>('[name="password"]');
+            const remember = form.querySelector<HTMLInputElement>('[name="remember"]');
+            if (!username?.value.trim() || !password?.value) {
+                return;
+            }
+            const input = {username: username.value.trim(), password: password.value, remember: !!remember?.checked, enableSync: true};
+            usernameValue = input.username;
+            rememberDevice = input.remember;
+            password.value = "";
+            void runAction(() => fetchSyncPost("/api/sync/loginManagedStorage", input, undefined, false, controller.signal), true);
+        });
+        panel.querySelectorAll<HTMLButtonElement>("[data-managed-action]").forEach(button => {
+            button.addEventListener("click", () => {
+                switch (button.dataset.managedAction) {
+                    case "refresh":
+                        void refresh();
+                        break;
+                    case "logout":
+                        pendingSyncStarts.delete(root);
+                        void runAction(() => fetchSyncPost("/api/sync/logoutManagedStorage", {}, undefined, false, controller.signal), true);
+                        break;
+                    case "start":
+                        pendingSyncStarts.set(root, status.accountId);
+                        void maybeStartSync();
+                        break;
+                    case "importKey":
+                    case "initKey":
+                        pendingSyncStarts.set(root, status.accountId);
+                        root.querySelector<HTMLButtonElement>(`#${button.dataset.managedAction}`)?.click();
+                        break;
+                }
+            });
+        });
+    };
+
+    const confirmSourceChange = () => !window.siyuan.config.sync.enabled || new Promise<boolean>(resolve => {
+        confirmDialog(L.managedStorageTitle, L.managedStorageModeChangeTip, () => resolve(true), () => resolve(false));
+    });
+
+    const maybeStartSync = async () => {
+        const accountId = pendingSyncStarts.get(root);
+        if (!accountId || starting || !mounted() || window.siyuan.config.readonly) return;
+        starting = true;
+        render();
+        try {
+            const response = await fetchSyncPost("/api/sync/setManagedStorageMode", {managed: true, enableSync: true, accountId}, undefined, false, controller.signal);
+            if (!mounted()) return;
+            if (response.code === 0) {
+                pendingSyncStarts.delete(root);
+                window.siyuan.config.sync.enabled = true;
+                const toggle = root.querySelector<HTMLInputElement>('[id="sync.enabled"]');
+                if (toggle) toggle.checked = true;
+                updateStatus(response.data);
+            } else {
+                error = errorText(response.msg);
+            }
+        } catch {
+            if (mounted()) error = L.managedStorageUnavailable;
+        } finally {
+            starting = false;
+            render();
+        }
+    };
+    setupCallbacks.set(root, maybeStartSync);
+
+    const runAction = async (operation: () => Promise<ActionResult>, changesSource: boolean) => {
+        if (busy || window.siyuan.config.readonly) {
+            return;
+        }
+        busy = true;
+        error = "";
+        try {
+            if (changesSource && !await confirmSourceChange() || !mounted()) {
+                return;
+            }
+            render();
+            const response = await operation();
+            if (!mounted()) {
+                return;
+            }
+            if (response.code === 0) {
+                updateStatus(response.data);
+                if (response.data.syncPending) {
+                    await maybeStartSync();
+                }
+                if (!response.data.loggedIn && response.data.managed) {
+                    window.siyuan.config.sync.enabled = false;
+                }
+                onChange();
+            } else {
+                error = errorText(response.msg);
+            }
+        } catch {
+            if (mounted()) {
+                error = L.managedStorageUnavailable;
+            }
+        } finally {
+            busy = false;
+            render();
+        }
+    };
+
+    const refresh = async () => {
+        if (busy || !mounted()) {
+            return;
+        }
+        busy = true;
+        error = "";
+        render();
+        try {
+            const response = await fetchSyncPost("/api/sync/getManagedStorageStatus", {refresh: true}, undefined, false, controller.signal);
+            if (mounted()) {
+                if (response.code === 0) {
+                    updateStatus(response.data);
+                    if (response.data.syncPending) await maybeStartSync();
+                } else {
+                    error = errorText(response.msg);
+                }
+            }
+        } catch {
+            if (mounted()) {
+                error = L.managedStorageUnavailable;
+            }
+        } finally {
+            busy = false;
+            render();
+        }
+    };
+
+    void refresh();
+};
