+)
+
+func TestManagedStorageComputerUseServer(t *testing.T) {
+	directory := os.Getenv("SIYUAN_MANAGED_STORAGE_UI_DIR")
+	stopFile := os.Getenv("SIYUAN_MANAGED_STORAGE_UI_STOP")
+	if directory == "" || stopFile == "" {
+		t.Skip("interactive Computer Use fixture requires an explicit UI directory and stop file")
+	}
+	syncTestConfiguration(t)
+	previousHome, previousWorkspace, previousConf := util.HomeDir, util.WorkspaceDir, util.ConfDir
+	previousData, previousRepo, previousHistory := util.DataDir, util.RepoDir, util.HistoryDir
+	util.HomeDir, util.WorkspaceDir = t.TempDir(), t.TempDir()
+	util.ConfDir, util.DataDir = filepath.Join(util.WorkspaceDir, "conf"), filepath.Join(util.WorkspaceDir, "data")
+	util.RepoDir, util.HistoryDir = filepath.Join(util.WorkspaceDir, "repo"), filepath.Join(util.WorkspaceDir, "history")
+	for _, path := range []string{util.ConfDir, util.DataDir, util.RepoDir, util.HistoryDir} {
+		if err := os.MkdirAll(path, 0700); err != nil {
+			t.Fatal(err)
+		}
+	}
+	t.Cleanup(func() {
+		util.HomeDir, util.WorkspaceDir, util.ConfDir = previousHome, previousWorkspace, previousConf
+		util.DataDir, util.RepoDir, util.HistoryDir = previousData, previousRepo, previousHistory
+	})
+	util.ReadOnly = false
+	model.Conf.Repo.Store(conf.NewRepo())
+	model.Conf.System.Store(conf.NewSystem())
+	model.Conf.SetUser(&conf.User{UserId: "0", UserToken: "token", UserSiYuanOneTimePayStatus: 1, UserSiYuanProExpireTime: -1})
+	model.Conf.Repo.Load().Key = make([]byte, 32)
+	if _, err := rand.Read(model.Conf.Repo.Load().Key); err != nil {
+		t.Fatal(err)
+	}
+	model.Conf.Sync.Load().Provider = conf.ProviderS3
+	model.Conf.Sync.Load().S3 = &conf.S3{Endpoint: "https://manual.example", Bucket: "manual-preserved", Region: "us-east-1", AccessKey: "manual-fixture", SecretKey: "manual-fixture-secret"}
+	cookieBytes := make([]byte, 32)
+	if _, err := rand.Read(cookieBytes); err != nil {
+		t.Fatal(err)
+	}
+	cookie := hex.EncodeToString(cookieBytes)
+	engine := gin.New()
+	engine.Use(gin.Recovery(), func(c *gin.Context) {
+		if origin := c.Request.Header.Get("Origin"); origin != "" {
+			u, err := url.Parse(origin)
+			if err != nil || u.Host != c.Request.Host {
+				c.AbortWithStatus(403)
+				return
+			}
+		}
+		if len(c.Request.URL.Path) >= 5 && c.Request.URL.Path[:5] == "/api/" {
+			value, err := c.Cookie("managed-storage-qa")
+			if err != nil || value != cookie {
+				c.AbortWithStatus(401)
+				return
+			}
+			c.Set(model.RoleContextKey, model.RoleAdministrator)
+		}
+	})
+	engine.GET("/", func(c *gin.Context) {
+		http.SetCookie(c.Writer, &http.Cookie{Name: "managed-storage-qa", Value: cookie, Path: "/", HttpOnly: true, SameSite: http.SameSiteStrictMode})
+		c.File(filepath.Join(directory, "index.html"))
+	})
+	engine.StaticFS("/assets", http.Dir(directory))
+	registerSyncRoutes(engine)
+	listener, err := net.Listen("tcp", "127.0.0.1:19406")
+	if err != nil {
+		t.Fatal(err)
+	}
+	server := &http.Server{Handler: engine, ReadHeaderTimeout: 5 * time.Second}
+	serveDone := make(chan error, 1)
+	go func() { serveDone <- server.Serve(listener) }()
+	t.Log("Computer Use fixture ready at http://127.0.0.1:19406; production component and kernel routes with isolated data")
+	ticker := time.NewTicker(250 * time.Millisecond)
+	defer ticker.Stop()
+	for {
+		select {
+		case err := <-serveDone:
+			if err != nil && err != http.ErrServerClosed {
+				t.Fatal(err)
+			}
+			return
+		case <-ticker.C:
+			if _, err := os.Stat(stopFile); err == nil {
+				ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+				_ = server.Shutdown(ctx)
+				cancel()
+				return
+			}
+		}
+	}
+}
