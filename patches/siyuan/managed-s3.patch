+// SiYuan - https://github.com/siyuan-note/siyuan
+// Copyright (c) 2020-present, b3log.org
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+package api
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/siyuan-note/siyuan/kernel/model"
+)
+
+func TestManagedStorageAPIPermissionsBeforeBody(t *testing.T) {
+	syncTestConfiguration(t)
+	for _, path := range []string{"/api/sync/getManagedStorageStatus", "/api/sync/loginManagedStorage", "/api/sync/logoutManagedStorage", "/api/sync/setManagedStorageMode"} {
+		for _, role := range []model.Role{model.RoleReader, model.RoleEditor} {
+			engine := gin.New()
+			engine.Use(func(c *gin.Context) { c.Set(model.RoleContextKey, role) })
+			registerSyncRoutes(engine)
+			recorder := httptest.NewRecorder()
+			engine.ServeHTTP(recorder, httptest.NewRequest("POST", path, strings.NewReader("malformed body")))
+			if recorder.Code != http.StatusForbidden || recorder.Body.Len() != 0 {
+				t.Fatalf("non-admin could reach managed storage handler: %s", path)
+			}
+		}
+	}
+}
+
+func TestManagedStorageAPIStatusHasNoSecrets(t *testing.T) {
+	syncTestConfiguration(t)
+	t.Setenv("SIYUAN_MANAGED_STORAGE_ORIGIN", "")
+	original := model.ManagedStorageOrigin
+	model.ManagedStorageOrigin = ""
+	t.Cleanup(func() { model.ManagedStorageOrigin = original })
+	engine := gin.New()
+	engine.Use(func(c *gin.Context) { c.Set(model.RoleContextKey, model.RoleAdministrator) })
+	registerSyncRoutes(engine)
+	recorder := httptest.NewRecorder()
+	engine.ServeHTTP(recorder, httptest.NewRequest("POST", "/api/sync/getManagedStorageStatus", strings.NewReader(`{}`)))
+	requireAPIContract(t, "POST", "/api/sync/getManagedStorageStatus", recorder)
+	var response struct {
+		Code int                        `json:"code"`
+		Data map[string]json.RawMessage `json:"data"`
+	}
+	if err := json.Unmarshal(recorder.Body.Bytes(), &response); err != nil || response.Code != 0 || recorder.Header().Get("Cache-Control") != "no-store" {
+		t.Fatal("status response or cache policy invalid")
+	}
+	for field := range response.Data {
+		lower := strings.ToLower(field)
+		if strings.Contains(lower, "token") || strings.Contains(lower, "password") || strings.Contains(lower, "secret") || strings.Contains(lower, "accesskey") {
+			t.Fatal("status declared a credential field")
+		}
+	}
+}
