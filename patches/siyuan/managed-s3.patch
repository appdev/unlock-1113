+
+// 下载和标签发布分别调用公共入口，避免 DownloadTagIndex 与 AddTag 重复获取依赖内部的仓库锁。
+// AddTag 自行校验索引并与清理互斥；索引已被并发清理时返回失败，不发布悬空标签。
+func downloadCloudSnapshotIndex(repo *dejavu.Repo, tag, id string, ctx map[string]any) (files, chunks int, bytes int64, err error) {
+	files, chunks, bytes, err = repo.DownloadIndex(id, ctx)
+	if err == nil && tag != "" {
+		err = repo.AddTag(id, tag)
+	}
+	return
+}
