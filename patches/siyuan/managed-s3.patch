+	write(b, "local.txt", []byte("second device local note"))
+	if _, err = b.Index("second device", true, nil); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err = b.Sync(nil); err != nil {
+		t.Fatalf("real peer download failed: %v", err)
+	}
+	deferred, err := b.DeferredAssets()
+	if err != nil || len(deferred) == 0 {
+		t.Fatal("on-demand attachment was not deferred")
+	}
+	if _, err = os.Stat(filepath.Join(b.DataPath, "assets/attachment.bin")); !os.IsNotExist(err) {
+		t.Fatal("on-demand attachment was downloaded before request")
