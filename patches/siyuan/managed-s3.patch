+func TestManagedStorageRealGateway(t *testing.T) {
+	if os.Getenv("SIYUAN_MANAGED_STORAGE_E2E") != "1" {
+		t.Skip("requires the isolated portal and RustFS integration environment")
+	}
+	setupCloudAccountAuthTest(t)
+	oldHome, oldWorkspace := util.HomeDir, util.WorkspaceDir
+	util.HomeDir, util.WorkspaceDir = t.TempDir(), t.TempDir()
+	t.Cleanup(func() { util.HomeDir, util.WorkspaceDir = oldHome, oldWorkspace })
+	Conf.Sync.Load().Provider, Conf.Sync.Load().Enabled = conf.ProviderS3, false
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Minute)
+	defer cancel()
+	if _, err := LoginManagedStorage(ctx, os.Getenv("SIYUAN_MANAGED_STORAGE_TEST_USERNAME"), os.Getenv("SIYUAN_MANAGED_STORAGE_TEST_PASSWORD"), false); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _, _ = LogoutManagedStorage(context.Background()) })
+	config, err := effectiveSyncS3()
+	if err != nil {
+		t.Fatal(err)
+	}
+	svc := s3sdk.New(s3sdk.Options{Region: config.Region, BaseEndpoint: aws.String(config.Endpoint), UsePathStyle: true,
+		Credentials: credentials.NewStaticCredentialsProvider(config.AccessKey, config.SecretKey, ""), HTTPClient: &http.Client{Timeout: 20 * time.Second}})
+	prefix := fmt.Sprintf("managed-probe/%d/", time.Now().UnixNano())
+	keys := make([]string, 0, 1000)
+	t.Cleanup(func() {
+		for _, key := range keys {
+			_, _ = svc.DeleteObject(context.Background(), &s3sdk.DeleteObjectInput{Bucket: aws.String(config.Bucket), Key: aws.String(key)})
+		}
+	})
+	data := []byte(strings.Repeat("storage-probe", 128))
+	start, firstHundred := time.Now(), time.Duration(0)
+	for i := 0; i < 1000; i++ {
+		key := fmt.Sprintf("%s%04d 空格+中文.bin", prefix, i)
+		keys = append(keys, key)
+		if _, err = svc.PutObject(ctx, &s3sdk.PutObjectInput{Bucket: aws.String(config.Bucket), Key: aws.String(key), Body: bytes.NewReader(data)}); err != nil {
+			t.Fatalf("real SDK write %d failed: %v", i, err)
+		}
+		if i == 99 {
+			firstHundred = time.Since(start)
+		}
+	}
+	t.Logf("real gateway 1000 objects: first 100=%s, next 900=%s", firstHundred, time.Since(start)-firstHundred)
+	head, err := svc.HeadObject(ctx, &s3sdk.HeadObjectInput{Bucket: aws.String(config.Bucket), Key: aws.String(keys[0])})
+	if err != nil || aws.ToInt64(head.ContentLength) != int64(len(data)) {
+		t.Fatal("real HEAD metadata mismatch")
+	}
+	part, err := svc.GetObject(ctx, &s3sdk.GetObjectInput{Bucket: aws.String(config.Bucket), Key: aws.String(keys[0]), Range: aws.String("bytes=2-8"), ResponseCacheControl: aws.String("no-cache")})
+	if err != nil {
+		t.Fatal(err)
+	}
+	read, err := io.ReadAll(part.Body)
+	_ = part.Body.Close()
+	if err != nil || !bytes.Equal(read, data[2:9]) || aws.ToString(part.CacheControl) != "no-cache" {
+		t.Fatal("real SDK Range/response override mismatch")
+	}
+	count := 0
+	pages := s3sdk.NewListObjectsV2Paginator(svc, &s3sdk.ListObjectsV2Input{Bucket: aws.String(config.Bucket), Prefix: aws.String(prefix), MaxKeys: aws.Int32(137)})
+	for pages.HasMorePages() {
+		page, err := pages.NextPage(ctx)
+		if err != nil {
+			t.Fatal(err)
+		}
+		count += len(page.Contents)
+	}
+	if count != len(keys) {
+		t.Fatalf("real SDK V2 pagination counted %d, want %d", count, len(keys))
+	}
+}
