+		base := filepath.Join(t.TempDir(), name)
+		backend := cloud.NewS3(&cloud.BaseCloud{Conf: &cloud.Conf{Dir: "main", RepoPath: filepath.Join(base, "repo"), AvailableSize: 10_000_000_000,
+			S3: &cloud.ConfS3{Endpoint: config.Endpoint, Bucket: config.Bucket, AccessKey: config.AccessKey, SecretKey: config.SecretKey, Region: config.Region, PathStyle: true, Timeout: 30, ConcurrentReqs: 2}}}, &http.Client{})
+		repo, err := dejavu.NewRepo(filepath.Join(base, "data"), filepath.Join(base, "repo"), filepath.Join(base, "history"), filepath.Join(base, "temp"), name, name, "linux", encryptionKey, nil, backend)
+		if err != nil {
+			t.Fatal(err)
