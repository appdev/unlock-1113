+	}
+
+	// 托管模式下第二个设备从零恢复密钥；不能复制首设备的密钥来代替验证。
+	util.WorkspaceDir = t.TempDir()
+	if custody {
+		Conf.Repo.Load().Key = nil
+	}
+	if _, err = login(context.Background(), username, password, false); err != nil {
+		t.Fatal(err)
+	}
+	if custody && !bytes.Equal(Conf.Repo.Load().Key, key) {
