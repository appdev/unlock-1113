+++ b/kernel/model/qingyu_release_test.go
@@ -0,0 +1,56 @@
+package model
+
+import (
+	"testing"
+	"time"
+
+	"github.com/siyuan-note/siyuan/kernel/conf"
+)
+
+func TestQingYuStableUpdate(t *testing.T) {
+	githubReleasesLock.Lock()
+	originalReleases, originalTime := cachedGitHubReleases, githubReleasesCacheTime
+	cachedGitHubReleases = []*githubRelease{
+		{TagName: "v3.8.9", HTMLURL: "https://example.invalid/releases"},
+		{TagName: "v3.8.9-qingyu.1"},
+		{TagName: "v3.8.9-qingyu.2", HTMLURL: "https://example.invalid/releases"},
+		{TagName: "v3.8.9-qingyu.3", Draft: true},
+		{TagName: "v3.8.9-qingyu.4", Prerelease: true},
+		{TagName: "v3.8.10-beta.1", Prerelease: true},
+	}
+	githubReleasesCacheTime = time.Now().Unix()
+	githubReleasesLock.Unlock()
+	t.Cleanup(func() {
+		githubReleasesLock.Lock()
+		cachedGitHubReleases, githubReleasesCacheTime = originalReleases, originalTime
+		githubReleasesLock.Unlock()
+	})
+
+	release, err := getGitHubUpdateRelease(conf.UpdateChannelStable, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if release.Version != "3.8.9-qingyu.2" || release.ReleaseURL != "https://sy.apkdv.com/download" || len(release.Packages) != 0 {
+		t.Fatalf("unexpected stable QingYu release: %+v", release)
+	}
+
+	originalBuild := qingyuBuildTag
+	t.Cleanup(func() { qingyuBuildTag = originalBuild })
+	qingyuBuildTag = "v3.8.9-qingyu.1"
+	if isVersionUpToDate(release.Version) {
+		t.Fatal("revision .1 did not detect revision .2")
+	}
+	qingyuBuildTag = "v3.8.9-qingyu.2"
+	if !isVersionUpToDate(release.Version) {
+		t.Fatal("revision .2 detected itself as newer")
+	}
+	if isVersionUpToDate("3.8.9-10") || isVersionUpToDate("3.8.9-3") || !isVersionUpToDate("3.8.9-2") {
+		t.Fatal("numeric revision tags must compare with the equivalent QingYu revision")
+	}
+	if isVersionUpToDate("3.8.10") {
+		t.Fatal("a newer base version must take precedence over its QingYu revision")
+	}
+	if !isVersionUpToDate("3.8.9-rc.1") {
+		t.Fatal("a same-version preview must not supersede a QingYu stable release")
+	}
+}
