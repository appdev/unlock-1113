diff --git a/kernel/model/qingyu_release.go b/kernel/model/qingyu_release.go
new file mode 100644
index 0000000..5db45a3
--- /dev/null
+++ b/kernel/model/qingyu_release.go
@@ -0,0 +1,44 @@
+package model
+
+import (
+	"regexp"
+
+	"golang.org/x/mod/semver"
+)
+
+const qingyuDownloadURL = "https://sy.apkdv.com/download"
+
+// Set by the release workflows. Local builds without a tag fall back to the upstream version.
+var qingyuBuildTag string
+
+var qingyuStableTag = regexp.MustCompile(`^(v[0-9]+\.[0-9]+\.[0-9]+)(?:-(?:qingyu\.)?([1-9][0-9]*))?$`)
+
+// A plain tag is revision zero. A QingYu revision is a stable build of the
+// same upstream version, so it sorts after the plain tag and after previews.
+func qingyuStableVersion(version string) (base, order string) {
+	tag := normalizeReleaseVersion(version)
+	parts := qingyuStableTag.FindStringSubmatch(tag)
+	if parts == nil || !semver.IsValid(tag) {
+		return "", ""
+	}
+	revision := parts[2]
+	if revision == "" {
+		revision = "0"
+	}
+	return parts[1], parts[1] + "-qingyu." + revision
+}
+
+func compareUpdateVersions(a, b string) int {
+	baseA, orderA := qingyuStableVersion(a)
+	baseB, orderB := qingyuStableVersion(b)
+	if baseA != "" && baseB != "" {
+		return semver.Compare(orderA, orderB)
+	}
+	if baseA == "" {
+		baseA = normalizeReleaseVersion(a)
+	}
+	if baseB == "" {
+		baseB = normalizeReleaseVersion(b)
+	}
+	return semver.Compare(baseA, baseB)
+}
diff --git a/kernel/model/qingyu_release_test.go b/kernel/model/qingyu_release_test.go
